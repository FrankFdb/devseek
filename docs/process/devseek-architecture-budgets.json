{
  "version": 2,
  "policy": "Design principles and coherent responsibility boundaries drive refactoring. Size budgets are regression guardrails, never optimization goals. A ceiling may only move down after a named responsibility, its dependencies, and its tests are extracted.",
  "implementationPolicy": {
    "priorityOrder": [
      "behavior-contract",
      "semantic-owner",
      "single-responsibility-boundary",
      "dependency-direction-and-interface-segregation",
      "testability-and-recovery",
      "size-budget"
    ],
    "sizeMetricRole": "regression-guardrail-only",
    "budgetDecreaseRequires": [
      "named-responsibility-extracted",
      "dependency-direction-preserved",
      "tests-move-with-responsibility",
      "legacy-owner-removed-or-semantic-free",
      "sibling-bypass-guarded"
    ],
    "prohibitedSizeOptimizations": [
      "delete-useful-explanations",
      "compress-formatting",
      "empty-wrapper-extraction",
      "arbitrary-line-based-splitting",
      "cyclic-or-reverse-dependency"
    ]
  },
