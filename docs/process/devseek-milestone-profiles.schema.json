{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devseek.local/schemas/devseek-milestone-profiles-v1.json",
  "title": "DevSeek Milestone Profiles v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "integrity", "claim_profiles", "profiles"],
  "properties": {
    "schema_version": { "const": "devseek.milestone-profiles/v1" },
    "integrity": { "$ref": "#/$defs/integrity" },
    "claim_profiles": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/claimProfile" }
    },
    "profiles": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/milestoneProfile" }
    }
  },
  "$defs": {
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hash_algorithm", "canonicalization_version"],
      "properties": {
        "hash_algorithm": { "const": "sha256" },
        "canonicalization_version": { "const": "devseek-canonical-json/v1" }
      }
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "capabilityId": {
      "type": "string",
      "pattern": "^C(?:[0-9]|1[0-4])-[A-Z0-9]+(?:-[A-Z0-9]+)*$"
    },
    "claimSelector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile_id", "profile_sha256", "claim_scope", "surface", "provider", "platform_profile"],
      "properties": {
        "profile_id": { "type": "string", "minLength": 1 },
        "profile_sha256": { "$ref": "#/$defs/sha256" },
        "claim_scope": { "type": "string", "minLength": 1 },
        "surface": { "type": "string", "minLength": 1 },
        "provider": { "type": "string", "minLength": 1 },
        "platform_profile": { "type": "string", "minLength": 1 }
      }
    },
    "claimProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "integrity", "profile_id", "profile_sha256", "claim_scope", "surface", "provider", "platform_profile"],
      "properties": {
        "schema_version": { "const": "devseek.qualification-claim-profile/v1" },
        "integrity": { "$ref": "#/$defs/integrity" },
        "profile_id": { "type": "string", "minLength": 1 },
        "profile_sha256": { "$ref": "#/$defs/sha256" },
        "claim_scope": { "type": "string", "minLength": 1 },
        "surface": { "type": "string", "minLength": 1 },
        "provider": { "type": "string", "minLength": 1 },
        "platform_profile": { "type": "string", "minLength": 1 }
      }
    },
    "requiredClaim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile_id", "profile_sha256", "claim_scope", "surface", "provider", "platform_profile", "minimum_level"],
      "properties": {
        "profile_id": { "type": "string", "minLength": 1 },
        "profile_sha256": { "$ref": "#/$defs/sha256" },
        "claim_scope": { "type": "string", "minLength": 1 },
        "surface": { "type": "string", "minLength": 1 },
        "provider": { "type": "string", "minLength": 1 },
        "platform_profile": { "type": "string", "minLength": 1 },
        "minimum_level": { "enum": ["L0", "L1", "L2", "L3", "L4", "L5", "L6"] }
      }
    },
    "selector": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "capability_ids": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/capabilityId" }
        },
        "domains": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "pattern": "^C(?:[0-9]|1[0-4])$" }
        },
        "prefixes": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required_implementation_state", "required_claim"],
      "properties": {
        "required_implementation_state": { "enum": ["specified", "implemented", "wired"] },
        "required_claim": { "$ref": "#/$defs/requiredClaim" }
      }
    },
    "dependencyRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rule_id", "specificity", "selector", "requirement"],
      "properties": {
        "rule_id": { "type": "string", "minLength": 1 },
        "specificity": { "type": "integer", "minimum": 0 },
        "selector": { "$ref": "#/$defs/selector" },
        "requirement": { "$ref": "#/$defs/requirement" }
      }
    },
    "group": {
      "type": "object",
      "additionalProperties": false,
      "required": ["group_id", "roots", "root_requirement", "dependency_rules", "default_dependency_requirement"],
      "properties": {
        "group_id": { "type": "string", "minLength": 1 },
        "roots": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/capabilityId" }
        },
        "root_requirement": { "$ref": "#/$defs/requirement" },
        "dependency_rules": {
          "type": "array",
          "items": { "$ref": "#/$defs/dependencyRule" }
        },
        "default_dependency_requirement": { "$ref": "#/$defs/requirement" }
      }
    },
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ledger_capabilities", "selected_capabilities", "group_closure_counts"],
      "properties": {
        "ledger_capabilities": { "type": "integer", "minimum": 1 },
        "selected_capabilities": { "type": "integer", "minimum": 1 },
        "group_closure_counts": {
          "type": "object",
          "additionalProperties": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "milestoneProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["integrity", "profile_id", "profile_sha256", "groups", "expected", "forbidden_required_qualification_levels"],
      "properties": {
        "integrity": { "$ref": "#/$defs/integrity" },
        "profile_id": { "type": "string", "minLength": 1 },
        "profile_sha256": { "$ref": "#/$defs/sha256" },
        "groups": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/group" }
        },
        "expected": { "$ref": "#/$defs/expected" },
        "forbidden_required_qualification_levels": {
          "type": "array",
          "items": { "enum": ["L0", "L1", "L2", "L3", "L4", "L5", "L6"] }
        }
      }
    }
  }
}
