{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devseek.local/schemas/devseek-c0-manifest-aggregator-wiring-v1.json",
  "title": "DevSeek Gate 0 C0 Manifest Aggregator Wiring v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "integrity",
    "wiring_id",
    "wiring_version",
    "source_status",
    "integrity_scope",
    "qualification_eligible",
    "qualification_effect",
    "claims_permitted",
    "asserts_gate_pass",
    "sources",
    "owners",
    "aggregation_contract",
    "aggregation_guards",
    "failure_oracles",
    "bypass_guards",
    "counts",
    "wiring_sha256"
  ],
  "properties": {
    "schema_version": { "const": "devseek.c0-manifest-aggregator-wiring/v1" },
    "integrity": { "$ref": "#/$defs/integrity" },
    "wiring_id": { "const": "DEVSEEK-GATE0-C0-MANIFEST-AGGREGATOR-WIRING/v1" },
    "wiring_version": { "const": 1 },
    "source_status": { "const": "verified" },
    "integrity_scope": { "const": "local-manifest-aggregator-wiring-conformance" },
    "qualification_eligible": { "const": false },
    "qualification_effect": { "const": "NONE" },
    "claims_permitted": { "const": false },
    "asserts_gate_pass": { "const": false },
    "sources": { "$ref": "#/$defs/sources" },
    "owners": { "$ref": "#/$defs/owners" },
    "aggregation_contract": { "$ref": "#/$defs/aggregationContract" },
    "aggregation_guards": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": { "$ref": "#/$defs/coverageEntry" }
    },
    "failure_oracles": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": { "$ref": "#/$defs/failureOracle" }
    },
    "bypass_guards": { "$ref": "#/$defs/bypassGuards" },
    "counts": { "$ref": "#/$defs/counts" },
    "wiring_sha256": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "nonEmpty": {
      "type": "string",
      "minLength": 1
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hash_algorithm", "canonicalization_version"],
      "properties": {
        "hash_algorithm": { "const": "sha256" },
        "canonicalization_version": { "const": "devseek-canonical-json/v1" }
      }
    },
    "sourceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "source_sha256"],
      "properties": {
        "path": { "$ref": "#/$defs/nonEmpty" },
        "source_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "sources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capability_ledger",
        "aggregator_policy",
        "aggregator_policy_schema",
        "qualification_evidence_manifest_schema",
        "qualification_retention_lock_schema",
        "qualification_plan_schema",
        "qualification_event_schema",
        "qualification_receipt_schema",
        "run_evidence_correlation_schema",
        "run_evidence_wiring_source",
        "qualification_evidence_manifest_source",
        "qualification_evidence_manifest_checker",
        "qualification_evidence_manifest_oracle",
        "package_scripts",
        "phase_gate_source",
        "checker_source",
        "oracle_source"
      ],
      "properties": {
        "capability_ledger": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "schema_version", "ledger_id", "source_sha256"],
          "properties": {
            "path": { "const": "docs/process/devseek-capability-ledger.json" },
            "schema_version": { "const": "devseek.capability-ledger/v1" },
            "ledger_id": { "const": "DEVSEEK-CAPABILITY-LEDGER/v1" },
            "source_sha256": { "$ref": "#/$defs/sha256" }
          }
        },
        "aggregator_policy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "policy_id", "policy_sha256", "source_sha256"],
          "properties": {
            "path": { "const": "docs/process/devseek-qualification-aggregator-policy.json" },
            "policy_id": { "$ref": "#/$defs/nonEmpty" },
            "policy_sha256": { "$ref": "#/$defs/sha256" },
            "source_sha256": { "$ref": "#/$defs/sha256" }
          }
        },
        "aggregator_policy_schema": { "$ref": "#/$defs/sourceRef" },
        "qualification_evidence_manifest_schema": { "$ref": "#/$defs/sourceRef" },
        "qualification_retention_lock_schema": { "$ref": "#/$defs/sourceRef" },
        "qualification_plan_schema": { "$ref": "#/$defs/sourceRef" },
        "qualification_event_schema": { "$ref": "#/$defs/sourceRef" },
        "qualification_receipt_schema": { "$ref": "#/$defs/sourceRef" },
        "run_evidence_correlation_schema": { "$ref": "#/$defs/sourceRef" },
        "run_evidence_wiring_source": { "$ref": "#/$defs/sourceRef" },
        "qualification_evidence_manifest_source": { "$ref": "#/$defs/sourceRef" },
        "qualification_evidence_manifest_checker": { "$ref": "#/$defs/sourceRef" },
        "qualification_evidence_manifest_oracle": { "$ref": "#/$defs/sourceRef" },
        "package_scripts": { "$ref": "#/$defs/sourceRef" },
        "phase_gate_source": { "$ref": "#/$defs/sourceRef" },
        "checker_source": { "$ref": "#/$defs/sourceRef" },
        "oracle_source": { "$ref": "#/$defs/sourceRef" }
      }
    },
    "owners": {
      "type": "object",
      "additionalProperties": false,
      "required": ["aggregator", "evidence_manifest"],
      "properties": {
        "aggregator": { "$ref": "#/$defs/owner" },
        "evidence_manifest": { "$ref": "#/$defs/owner" }
      }
    },
    "owner": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capability_id",
        "implementation_state",
        "authority_port",
        "required_component_paths",
        "verification_commands",
        "verification_has_qualification_evidence_manifest",
        "verification_has_c0_manifest_aggregator_wiring",
        "expected_authority_port"
      ],
      "properties": {
        "capability_id": { "enum": ["C0-QUALIFICATION-AGGREGATOR", "C0-QUALIFICATION-EVIDENCE-MANIFEST"] },
        "implementation_state": { "const": "wired" },
        "authority_port": { "enum": ["QualificationAggregationPort", "QualificationEvidenceManifestPort"] },
        "required_component_paths": {
          "type": "array",
          "minItems": 12,
          "maxItems": 12,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "present"],
            "properties": {
              "path": { "$ref": "#/$defs/nonEmpty" },
              "present": { "const": true }
            }
          }
        },
        "verification_commands": {
          "type": "array",
          "minItems": 2,
          "items": { "$ref": "#/$defs/nonEmpty" }
        },
        "verification_has_qualification_evidence_manifest": { "const": true },
        "verification_has_c0_manifest_aggregator_wiring": { "const": true },
        "expected_authority_port": { "enum": ["QualificationAggregationPort", "QualificationEvidenceManifestPort"] }
      }
    },
    "aggregationContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "adapter_id",
        "adapter_source_ref",
        "policy_path",
        "manifest_schema_path",
        "retention_schema_path",
        "package_script_present",
        "phase_gate_id",
        "phase_gate_present",
        "policy_local_only",
        "policy_has_zero_repository_claim_rules",
        "manifest_schema_requires_run_evidence_auxiliary",
        "retention_schema_requires_external_anchor_boundary",
        "policy_schema_forbids_unknowns",
        "run_evidence_wiring_is_prerequisite",
        "reader_recomputes_manifest_derivation",
        "reader_rejects_writer_summary",
        "reader_verifies_retention_and_anchor",
        "reader_checks_current_state_and_provenance",
        "reader_preserves_failures_and_vetoes",
        "reader_requires_exact_dependency_tuple",
        "reader_consumes_run_evidence_as_auxiliary",
        "aggregator_produces_protected_claims_locally",
        "same_repository_hash_is_trust_root",
        "writer_summary_is_authoritative",
        "qualification_effect"
      ],
      "properties": {
        "adapter_id": { "const": "G0-C-MANIFEST-AGGREGATOR-ADAPTER/v1" },
        "adapter_source_ref": { "const": "scripts/lib/devseek-qualification-evidence-manifest.mjs#aggregateQualificationEvidence" },
        "policy_path": { "const": "docs/process/devseek-qualification-aggregator-policy.json" },
        "manifest_schema_path": { "const": "docs/process/devseek-qualification-evidence-manifest.schema.json" },
        "retention_schema_path": { "const": "docs/process/devseek-qualification-retention-lock.schema.json" },
        "package_script_present": { "const": true },
        "phase_gate_id": { "const": "c0-manifest-aggregator-wiring-conformance" },
        "phase_gate_present": { "const": true },
        "policy_local_only": { "const": true },
        "policy_has_zero_repository_claim_rules": { "const": true },
        "manifest_schema_requires_run_evidence_auxiliary": { "const": true },
        "retention_schema_requires_external_anchor_boundary": { "const": true },
        "policy_schema_forbids_unknowns": { "const": true },
        "run_evidence_wiring_is_prerequisite": { "const": true },
        "reader_recomputes_manifest_derivation": { "const": true },
        "reader_rejects_writer_summary": { "const": true },
        "reader_verifies_retention_and_anchor": { "const": true },
        "reader_checks_current_state_and_provenance": { "const": true },
        "reader_preserves_failures_and_vetoes": { "const": true },
        "reader_requires_exact_dependency_tuple": { "const": true },
        "reader_consumes_run_evidence_as_auxiliary": { "const": true },
        "aggregator_produces_protected_claims_locally": { "const": false },
        "same_repository_hash_is_trust_root": { "const": false },
        "writer_summary_is_authoritative": { "const": false },
        "qualification_effect": { "const": "NONE" }
      }
    },
    "coverageEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["guard_id", "source_ref", "required_fragments", "fragments_present", "coverage_status"],
      "properties": {
        "guard_id": { "$ref": "#/$defs/nonEmpty" },
        "source_ref": { "$ref": "#/$defs/nonEmpty" },
        "required_fragments": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/nonEmpty" }
        },
        "fragments_present": { "const": true },
        "coverage_status": { "const": "covered" }
      }
    },
    "failureOracle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["oracle_id", "expected_error", "source_ref", "fragments_present", "coverage_status"],
      "properties": {
        "oracle_id": { "$ref": "#/$defs/nonEmpty" },
        "expected_error": { "$ref": "#/$defs/nonEmpty" },
        "source_ref": { "const": "scripts/test/devseek-qualification-evidence-manifest.test.mjs" },
        "fragments_present": { "const": true },
        "coverage_status": { "const": "covered" }
      }
    },
    "bypassGuards": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "writer_summary_trusted",
        "same_repository_self_hash_trusted_as_protected_authority",
        "any_profile_some_claim_allowed",
        "local_manifest_claims_permitted",
        "external_authority_fabricated",
        "product_run_evidence_may_promote_claim"
      ],
      "properties": {
        "writer_summary_trusted": { "const": false },
        "same_repository_self_hash_trusted_as_protected_authority": { "const": false },
        "any_profile_some_claim_allowed": { "const": false },
        "local_manifest_claims_permitted": { "const": false },
        "external_authority_fabricated": { "const": false },
        "product_run_evidence_may_promote_claim": { "const": false }
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "owners",
        "owner_required_components",
        "owner_required_components_present",
        "aggregation_guards",
        "aggregation_guards_covered",
        "failure_oracles",
        "failure_oracles_covered",
        "bypasses",
        "qualification_claims"
      ],
      "properties": {
        "owners": { "const": 2 },
        "owner_required_components": { "const": 24 },
        "owner_required_components_present": { "const": 24 },
        "aggregation_guards": { "const": 8 },
        "aggregation_guards_covered": { "const": 8 },
        "failure_oracles": { "const": 8 },
        "failure_oracles_covered": { "const": 8 },
        "bypasses": { "const": 0 },
        "qualification_claims": { "const": 0 }
      }
    }
  }
}
