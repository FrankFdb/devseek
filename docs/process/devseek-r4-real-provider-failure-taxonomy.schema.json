{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devseek.local/schemas/devseek-r4-real-provider-failure-taxonomy-v1.json",
  "title": "DevSeek R4 Real Provider Failure Taxonomy v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "integrity",
    "taxonomy_id",
    "taxonomy_version",
    "source_status",
    "integrity_scope",
    "qualification_eligible",
    "qualification_effect",
    "claims_permitted",
    "asserts_gate_pass",
    "observation_authority",
    "source_bindings",
    "rerun_policy",
    "categories",
    "counts",
    "taxonomy_sha256"
  ],
  "properties": {
    "schema_version": { "const": "devseek.r4-real-provider-failure-taxonomy/v1" },
    "integrity": { "$ref": "#/$defs/integrity" },
    "taxonomy_id": { "const": "R4-REAL-PROVIDER-FAILURE-TAXONOMY/v1" },
    "taxonomy_version": { "const": 1 },
    "source_status": { "const": "generated-failure-taxonomy-only" },
    "integrity_scope": { "const": "local-r4-real-provider-failure-taxonomy" },
    "qualification_eligible": { "const": false },
    "qualification_effect": { "const": "NONE" },
    "claims_permitted": { "const": false },
    "asserts_gate_pass": { "const": false },
    "observation_authority": { "$ref": "#/$defs/observationAuthority" },
    "source_bindings": { "$ref": "#/$defs/sourceBindings" },
    "rerun_policy": { "$ref": "#/$defs/rerunPolicy" },
    "categories": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "items": { "$ref": "#/$defs/category" }
    },
    "counts": { "$ref": "#/$defs/counts" },
    "taxonomy_sha256": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "nonEmpty": {
      "type": "string",
      "minLength": 1
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hash_algorithm", "canonicalization_version"],
      "properties": {
        "hash_algorithm": { "const": "sha256" },
        "canonicalization_version": { "const": "devseek-canonical-json/v1" }
      }
    },
    "observationAuthority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "semantic_authority",
        "writes_product_state",
        "provider_actions",
        "live_holdout_actions",
        "runtime_process_observation",
        "install_or_window_actions",
        "secret_observation"
      ],
      "properties": {
        "semantic_authority": { "const": "R4RealProviderFailureTaxonomy" },
        "writes_product_state": { "const": false },
        "provider_actions": { "const": "FORBIDDEN" },
        "live_holdout_actions": { "const": "FORBIDDEN" },
        "runtime_process_observation": { "const": "FORBIDDEN" },
        "install_or_window_actions": { "const": "FORBIDDEN" },
        "secret_observation": { "const": "FORBIDDEN" }
      }
    },
    "sourceBindings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "live_user_way_holdout_matrix",
        "live_qualification_request_packet",
        "doc_process_identity_reconciliation",
        "r3_live_receipts_doc",
        "real_plugin_harness"
      ],
      "properties": {
        "live_user_way_holdout_matrix": { "$ref": "#/$defs/sourceBinding" },
        "live_qualification_request_packet": { "$ref": "#/$defs/sourceBinding" },
        "doc_process_identity_reconciliation": { "$ref": "#/$defs/sourceBinding" },
        "r3_live_receipts_doc": { "$ref": "#/$defs/sourceBinding" },
        "real_plugin_harness": { "$ref": "#/$defs/sourceBinding" }
      }
    },
    "sourceBinding": {
      "type": "object",
      "additionalProperties": true,
      "required": ["path", "source_sha256"],
      "properties": {
        "path": { "$ref": "#/$defs/nonEmpty" },
        "source_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "rerunPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repeat_same_red_loop_allowed_without_analysis",
        "required_evidence_before_rerun",
        "classify_before_code_change",
        "classify_before_harness_change",
        "classify_before_external_blocker",
        "generated_artifact_quality_required"
      ],
      "properties": {
        "repeat_same_red_loop_allowed_without_analysis": { "const": false },
        "required_evidence_before_rerun": {
          "type": "array",
          "minItems": 6,
          "items": { "$ref": "#/$defs/nonEmpty" }
        },
        "classify_before_code_change": { "const": true },
        "classify_before_harness_change": { "const": true },
        "classify_before_external_blocker": { "const": true },
        "generated_artifact_quality_required": { "const": true }
      }
    },
    "category": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "category_id",
        "title",
        "trigger_signals",
        "default_next_action",
        "required_evidence_before_rerun",
        "rerun_allowed_without_analysis",
        "local_fix_may_be_required",
        "external_blocker_may_be_recorded",
        "qualification_effect",
        "claims_permitted",
        "asserts_gate_pass"
      ],
      "properties": {
        "category_id": { "$ref": "#/$defs/nonEmpty" },
        "title": { "$ref": "#/$defs/nonEmpty" },
        "trigger_signals": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/nonEmpty" }
        },
        "default_next_action": { "$ref": "#/$defs/nonEmpty" },
        "required_evidence_before_rerun": {
          "type": "array",
          "minItems": 6,
          "items": { "$ref": "#/$defs/nonEmpty" }
        },
        "rerun_allowed_without_analysis": { "const": false },
        "local_fix_may_be_required": { "type": "boolean" },
        "external_blocker_may_be_recorded": { "type": "boolean" },
        "qualification_effect": { "const": "NONE" },
        "claims_permitted": { "const": false },
        "asserts_gate_pass": { "const": false }
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "categories",
        "required_evidence_items",
        "categories_allowing_rerun_without_analysis",
        "qualification_claims"
      ],
      "properties": {
        "categories": { "const": 10 },
        "required_evidence_items": { "const": 6 },
        "categories_allowing_rerun_without_analysis": { "const": 0 },
        "qualification_claims": { "const": 0 }
      }
    }
  }
}
