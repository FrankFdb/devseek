{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devseek.local/schemas/devseek-qualification-key-registry-v1.json",
  "title": "DevSeek Qualification Key Registry v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "integrity",
    "integrity_scope",
    "qualification_eligible",
    "source_status",
    "registry_id",
    "registry_version",
    "keys",
    "registry_sha256"
  ],
  "properties": {
    "schema_version": { "const": "devseek.qualification-key-registry/v1" },
    "integrity": { "$ref": "#/$defs/integrity" },
    "integrity_scope": {
      "enum": ["local-protocol-conformance", "protected-qualification"]
    },
    "qualification_eligible": { "type": "boolean" },
    "source_status": {
      "enum": ["verified", "hash-placeholders-require-canonical-regeneration"]
    },
    "registry_id": { "type": "string", "minLength": 1 },
    "registry_version": { "type": "integer", "minimum": 1 },
    "keys": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/key" }
    },
    "registry_sha256": { "$ref": "#/$defs/sha256" }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "integrity_scope": { "const": "local-protocol-conformance" }
        },
        "required": ["integrity_scope"]
      },
      "then": {
        "properties": {
          "qualification_eligible": { "const": false }
        }
      }
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hash_algorithm",
        "canonicalization_version",
        "signature_algorithm"
      ],
      "properties": {
        "hash_algorithm": { "const": "sha256" },
        "canonicalization_version": { "const": "devseek-canonical-json/v1" },
        "signature_algorithm": { "const": "ed25519" }
      }
    },
    "key": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key_id",
        "algorithm",
        "public_key_encoding",
        "public_key_spki_base64",
        "public_key_spki_sha256",
        "trust_scope",
        "identity",
        "purposes",
        "status",
        "valid_from",
        "expires_at",
        "private_key_material_prohibited",
        "integrity_scope",
        "qualification_eligible",
        "key_sha256"
      ],
      "properties": {
        "key_id": { "type": "string", "minLength": 1 },
        "algorithm": { "const": "ed25519" },
        "public_key_encoding": { "const": "spki-der-base64" },
        "public_key_spki_base64": {
          "type": "string",
          "minLength": 1
        },
        "public_key_spki_sha256": { "$ref": "#/$defs/sha256" },
        "trust_scope": {
          "enum": ["deterministic-test-only", "protected-qualification"]
        },
        "identity": { "type": "string", "minLength": 1 },
        "purposes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "qualification-plan",
              "runner-event",
              "oracle-classification",
              "infra-adjudication",
              "action-guard",
              "store-receipt"
            ]
          }
        },
        "status": { "enum": ["test-only", "active", "revoked", "expired"] },
        "valid_from": { "type": "string", "minLength": 1 },
        "expires_at": {
          "oneOf": [
            { "type": "string", "minLength": 1 },
            { "type": "null" }
          ]
        },
        "private_key_material_prohibited": { "const": true },
        "integrity_scope": {
          "enum": ["local-protocol-conformance", "protected-qualification"]
        },
        "qualification_eligible": { "type": "boolean" },
        "key_sha256": { "$ref": "#/$defs/sha256" }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "trust_scope": { "const": "deterministic-test-only" }
            },
            "required": ["trust_scope"]
          },
          "then": {
            "properties": {
              "status": { "const": "test-only" },
              "integrity_scope": { "const": "local-protocol-conformance" },
              "qualification_eligible": { "const": false }
            }
          }
        }
      ]
    }
  }
}
