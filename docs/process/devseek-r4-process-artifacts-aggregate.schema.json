{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devseek.local/schemas/devseek-r4-process-artifacts-aggregate-v1.json",
  "title": "DevSeek R4 Process Artifacts Aggregate v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "integrity",
    "aggregate_id",
    "aggregate_version",
    "source_status",
    "integrity_scope",
    "qualification_eligible",
    "qualification_effect",
    "claims_permitted",
    "asserts_gate_pass",
    "observation_authority",
    "source_bindings",
    "aggregate_scope",
    "artifacts",
    "counts",
    "aggregate_sha256"
  ],
  "properties": {
    "schema_version": { "const": "devseek.r4-process-artifacts-aggregate/v1" },
    "integrity": { "$ref": "#/$defs/integrity" },
    "aggregate_id": { "const": "R4-PROCESS-ARTIFACTS-AGGREGATE/v1" },
    "aggregate_version": { "const": 1 },
    "source_status": { "const": "generated-r4-process-artifacts-aggregate-only" },
    "integrity_scope": { "const": "local-r4-process-artifacts-aggregate" },
    "qualification_eligible": { "const": false },
    "qualification_effect": { "const": "NONE" },
    "claims_permitted": { "const": false },
    "asserts_gate_pass": { "const": false },
    "observation_authority": { "$ref": "#/$defs/observationAuthority" },
    "source_bindings": { "$ref": "#/$defs/sourceBindings" },
    "aggregate_scope": { "$ref": "#/$defs/aggregateScope" },
    "artifacts": {
      "type": "array",
      "minItems": 11,
      "maxItems": 11,
      "items": { "$ref": "#/$defs/artifact" }
    },
    "counts": { "$ref": "#/$defs/counts" },
    "aggregate_sha256": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "nonEmpty": {
      "type": "string",
      "minLength": 1
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hash_algorithm", "canonicalization_version"],
      "properties": {
        "hash_algorithm": { "const": "sha256" },
        "canonicalization_version": { "const": "devseek-canonical-json/v1" }
      }
    },
    "observationAuthority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "semantic_authority",
        "writes_product_state",
        "provider_actions",
        "live_holdout_actions",
        "runtime_process_observation",
        "install_or_window_actions",
        "secret_observation"
      ],
      "properties": {
        "semantic_authority": { "const": "R4ProcessArtifactsAggregate" },
        "writes_product_state": { "const": false },
        "provider_actions": { "const": "FORBIDDEN" },
        "live_holdout_actions": { "const": "FORBIDDEN" },
        "runtime_process_observation": { "const": "FORBIDDEN" },
        "install_or_window_actions": { "const": "FORBIDDEN" },
        "secret_observation": { "const": "FORBIDDEN" }
      }
    },
    "sourceBindings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "r4_release_candidate_manifest",
        "r4_doc_process_identity_reconciliation",
        "r4_live_qualification_request_packet",
        "r4_live_user_way_holdout_matrix",
        "r4_real_provider_failure_taxonomy",
        "r4_existing_live_failure_taxonomy_mapping",
        "r4_scenario_language_replay_corpus",
        "r4_iteration_status_rollup",
        "r4_clean_runtime_limited_observation",
        "r4_authorization_and_permission_guide",
        "post_r4_nonpermission_iteration_plan"
      ],
      "properties": {
        "r4_release_candidate_manifest": { "$ref": "#/$defs/sourceBinding" },
        "r4_doc_process_identity_reconciliation": { "$ref": "#/$defs/sourceBinding" },
        "r4_live_qualification_request_packet": { "$ref": "#/$defs/sourceBinding" },
        "r4_live_user_way_holdout_matrix": { "$ref": "#/$defs/sourceBinding" },
        "r4_real_provider_failure_taxonomy": { "$ref": "#/$defs/sourceBinding" },
        "r4_existing_live_failure_taxonomy_mapping": { "$ref": "#/$defs/sourceBinding" },
        "r4_scenario_language_replay_corpus": { "$ref": "#/$defs/sourceBinding" },
        "r4_iteration_status_rollup": { "$ref": "#/$defs/sourceBinding" },
        "r4_clean_runtime_limited_observation": { "$ref": "#/$defs/sourceBinding" },
        "r4_authorization_and_permission_guide": { "$ref": "#/$defs/sourceBinding" },
        "post_r4_nonpermission_iteration_plan": { "$ref": "#/$defs/sourceBinding" }
      }
    },
    "sourceBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "path",
        "source_sha256",
        "generated_view_path",
        "generated_view_sha256",
        "generated_view_status"
      ],
      "properties": {
        "artifact_id": { "$ref": "#/$defs/nonEmpty" },
        "path": { "$ref": "#/$defs/nonEmpty" },
        "source_sha256": { "$ref": "#/$defs/sha256" },
        "generated_view_path": {
          "anyOf": [
            { "$ref": "#/$defs/nonEmpty" },
            { "type": "null" }
          ]
        },
        "generated_view_sha256": {
          "anyOf": [
            { "$ref": "#/$defs/sha256" },
            { "type": "null" }
          ]
        },
        "generated_view_status": { "enum": ["MATCHED", "NOT_APPLICABLE"] }
      }
    },
    "aggregateScope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "r4_original_leaf_count",
        "process_artifacts_complete_except_clean_runtime",
        "clean_runtime_terminal_state",
        "qualification_effect",
        "claims_permitted",
        "asserts_gate_pass",
        "gate0_status",
        "r1_qualification_status",
        "live_or_provider_actions_performed",
        "permission_sensitive_actions_performed"
      ],
      "properties": {
        "r4_original_leaf_count": { "const": 6 },
        "process_artifacts_complete_except_clean_runtime": { "const": true },
        "clean_runtime_terminal_state": { "enum": ["COMPLETED", "BLOCKED"] },
        "qualification_effect": { "const": "NONE" },
        "claims_permitted": { "const": false },
        "asserts_gate_pass": { "const": false },
        "gate0_status": { "const": "NOT_PASSED" },
        "r1_qualification_status": { "const": "NOT_STARTED" },
        "live_or_provider_actions_performed": { "const": false },
        "permission_sensitive_actions_performed": { "const": false }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "source_kind",
        "primary_path",
        "source_sha256",
        "schema_version",
        "identity_hash_field",
        "identity_hash_value",
        "generated_view_path",
        "generated_view_sha256",
        "generated_view_status",
        "qualification_eligible",
        "qualification_effect",
        "claims_permitted",
        "asserts_gate_pass",
        "live_runs_authorized",
        "approved_live_requests",
        "no_claims_boundary_ok",
        "artifact_errors"
      ],
      "properties": {
        "artifact_id": { "$ref": "#/$defs/nonEmpty" },
        "source_kind": { "enum": ["generated-json", "manual-markdown"] },
        "primary_path": { "$ref": "#/$defs/nonEmpty" },
        "source_sha256": { "$ref": "#/$defs/sha256" },
        "schema_version": {
          "anyOf": [
            { "$ref": "#/$defs/nonEmpty" },
            { "type": "null" }
          ]
        },
        "identity_hash_field": {
          "anyOf": [
            { "$ref": "#/$defs/nonEmpty" },
            { "type": "null" }
          ]
        },
        "identity_hash_value": {
          "anyOf": [
            { "$ref": "#/$defs/sha256" },
            { "type": "null" }
          ]
        },
        "generated_view_path": {
          "anyOf": [
            { "$ref": "#/$defs/nonEmpty" },
            { "type": "null" }
          ]
        },
        "generated_view_sha256": {
          "anyOf": [
            { "$ref": "#/$defs/sha256" },
            { "type": "null" }
          ]
        },
        "generated_view_status": { "enum": ["MATCHED", "NOT_APPLICABLE"] },
        "qualification_eligible": { "const": false },
        "qualification_effect": { "const": "NONE" },
        "claims_permitted": { "const": false },
        "asserts_gate_pass": { "const": false },
        "live_runs_authorized": { "const": 0 },
        "approved_live_requests": { "const": 0 },
        "no_claims_boundary_ok": { "const": true },
        "artifact_errors": {
          "type": "array",
          "maxItems": 0
        }
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total_artifacts",
        "generated_json_artifacts",
        "manual_markdown_artifacts",
        "generated_views_expected",
        "generated_views_matched",
        "generated_views_missing",
        "generated_views_stale",
        "qualification_claim_violations",
        "live_runs_authorized",
        "approved_live_requests",
        "gate_assertions",
        "artifact_errors"
      ],
      "properties": {
        "total_artifacts": { "const": 11 },
        "generated_json_artifacts": { "const": 9 },
        "manual_markdown_artifacts": { "const": 2 },
        "generated_views_expected": { "const": 9 },
        "generated_views_matched": { "const": 9 },
        "generated_views_missing": { "const": 0 },
        "generated_views_stale": { "const": 0 },
        "qualification_claim_violations": { "const": 0 },
        "live_runs_authorized": { "const": 0 },
        "approved_live_requests": { "const": 0 },
        "gate_assertions": { "const": 0 },
        "artifact_errors": { "const": 0 }
      }
    }
  }
}
