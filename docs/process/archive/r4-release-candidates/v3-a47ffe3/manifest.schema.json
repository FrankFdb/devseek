{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devseek.local/schemas/devseek-r4-release-candidate-manifest-v3.json",
  "title": "DevSeek R4 Release Candidate Manifest v3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "integrity",
    "manifest_id",
    "manifest_version",
    "source_status",
    "integrity_scope",
    "local_evidence_class",
    "qualification_eligible",
    "qualification_effect",
    "claims_permitted",
    "asserts_gate_pass",
    "selection_boundary",
    "observation_authority",
    "version_lineage",
    "source_identity",
    "artifact_identity",
    "verification_receipts",
    "current_identity_probe_boundary",
    "r4_leaf_context",
    "counts",
    "manifest_sha256"
  ],
  "properties": {
    "schema_version": { "const": "devseek.r4-release-candidate-manifest/v3" },
    "integrity": { "$ref": "#/$defs/integrity" },
    "manifest_id": { "const": "R4-RELEASE-CANDIDATE-MANIFEST/v3" },
    "manifest_version": { "const": 3 },
    "source_status": { "const": "user-authorized-versioned-local-candidate-freeze" },
    "integrity_scope": { "const": "local-r4-release-candidate-manifest" },
    "local_evidence_class": { "const": "local-protocol-conformance" },
    "qualification_eligible": { "const": false },
    "qualification_effect": { "const": "NONE" },
    "claims_permitted": { "const": false },
    "asserts_gate_pass": { "const": false },
    "selection_boundary": { "$ref": "#/$defs/selectionBoundary" },
    "observation_authority": { "$ref": "#/$defs/observationAuthority" },
    "version_lineage": { "$ref": "#/$defs/versionLineage" },
    "source_identity": { "$ref": "#/$defs/sourceIdentity" },
    "artifact_identity": { "$ref": "#/$defs/artifactIdentity" },
    "verification_receipts": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": { "$ref": "#/$defs/verificationReceipt" }
    },
    "current_identity_probe_boundary": { "$ref": "#/$defs/currentIdentityProbeBoundary" },
    "r4_leaf_context": { "$ref": "#/$defs/r4LeafContext" },
    "counts": { "$ref": "#/$defs/counts" },
    "manifest_sha256": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "commit": {
      "type": "string",
      "pattern": "^[a-f0-9]{7,64}$"
    },
    "fullCommit": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "nonEmpty": {
      "type": "string",
      "minLength": 1
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hash_algorithm", "canonicalization_version"],
      "properties": {
        "hash_algorithm": { "const": "sha256" },
        "canonicalization_version": { "const": "devseek-canonical-json/v1" }
      }
    },
    "selectionBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authorization",
        "scope",
        "predecessor_mutation",
        "protected_release_candidate",
        "artifact_channel",
        "external_qualification_authority",
        "qualification_effect"
      ],
      "properties": {
        "authorization": { "const": "explicit-user-authorization" },
        "scope": { "const": "local-versioned-r4-candidate-freeze-only" },
        "predecessor_mutation": { "const": "FORBIDDEN" },
        "protected_release_candidate": { "const": false },
        "artifact_channel": { "const": "debug" },
        "external_qualification_authority": { "const": false },
        "qualification_effect": { "const": "NONE" }
      }
    },
    "observationAuthority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "semantic_authority",
        "writes_product_state",
        "provider_actions",
        "live_holdout_actions",
        "runtime_process_observation",
        "install_or_window_actions",
        "secret_observation"
      ],
      "properties": {
        "semantic_authority": { "const": "R4ReleaseCandidateManifest" },
        "writes_product_state": { "const": false },
        "provider_actions": { "const": "FORBIDDEN" },
        "live_holdout_actions": { "const": "FORBIDDEN" },
        "runtime_process_observation": { "const": "FORBIDDEN" },
        "install_or_window_actions": { "const": "FORBIDDEN" },
        "secret_observation": { "const": "FORBIDDEN" }
      }
    },
    "versionLineage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "predecessor_manifest_id",
        "predecessor_manifest_version",
        "predecessor_candidate_source_commit",
        "predecessor_candidate_vsix_sha256",
        "predecessor_manifest_sha256",
        "predecessor_manifest_path",
        "predecessor_manifest_file_sha256",
        "predecessor_schema_path",
        "predecessor_schema_file_sha256",
        "predecessor_generated_view_path",
        "predecessor_generated_view_file_sha256",
        "predecessor_status",
        "supersession_reason",
        "mutation_policy"
      ],
      "properties": {
        "predecessor_manifest_id": { "const": "R4-RELEASE-CANDIDATE-MANIFEST/v2" },
        "predecessor_manifest_version": { "const": 2 },
        "predecessor_candidate_source_commit": { "const": "4f8a56797090079914b4d921b56d9c34fe4d2abc" },
        "predecessor_candidate_vsix_sha256": { "const": "68b360307e4104909829d9e6f921757520f535cf79a33eff77f4b69590849ecc" },
        "predecessor_manifest_sha256": { "const": "0fda85f4ad71f13d6410d61f5249e327b299642cfee17226f708f979e12bed1b" },
        "predecessor_manifest_path": { "const": "docs/process/archive/r4-release-candidates/v2-4f8a567/manifest.json" },
        "predecessor_manifest_file_sha256": { "const": "8c051ecfbb718820332804f4cc690f26a54d2e243e26f91d030acbde5b94ea82" },
        "predecessor_schema_path": { "const": "docs/process/archive/r4-release-candidates/v2-4f8a567/manifest.schema.json" },
        "predecessor_schema_file_sha256": { "const": "face1ace312bdf8478301c8357222a697f750a210a58ddab769a50e4e5206b7f" },
        "predecessor_generated_view_path": { "const": "docs/process/archive/r4-release-candidates/v2-4f8a567/manifest.md" },
        "predecessor_generated_view_file_sha256": { "const": "56ac05c11e2f25c6e84066066eac06286cee13a154c9683b9a2eabfb49614e46" },
        "predecessor_status": { "const": "immutable-history" },
        "supersession_reason": { "const": "explicit-user-authorized-versioned-candidate-freeze" },
        "mutation_policy": { "const": "byte-for-byte-predecessor-preservation" }
      }
    },
    "sourceIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_source_commit",
        "artifact_source_short",
        "artifact_source_resolution",
        "verification_record_path",
        "verification_record_ref",
        "verification_record_commit",
        "current_candidate_identity_path",
        "current_candidate_identity_file_sha256",
        "current_candidate_identity_probe_sha256",
        "artifact_source_matches_current_identity"
      ],
      "properties": {
        "artifact_source_commit": { "const": "a47ffe37f01817d14358b0ef4040e885b7867c8f" },
        "artifact_source_short": { "const": "a47ffe3" },
        "artifact_source_resolution": { "const": "git rev-parse <vsix.devseekBuild.gitCommit>^{commit}" },
        "verification_record_path": { "const": "docs/top-agent-convergence-audit-20260711/HANDOFF-20260813-意图识别与真实用户仿真迭代.md" },
        "verification_record_ref": { "const": "docs/top-agent-convergence-audit-20260711/HANDOFF-20260813-意图识别与真实用户仿真迭代.md#2026-08-20-2032-t12-模型主导语义与动作回执收敛最新" },
        "verification_record_commit": { "const": "fa682086eb28c0a9ff15093de27dbb3518c4a89f" },
        "current_candidate_identity_path": { "const": "docs/process/devseek-current-candidate-identity.json" },
        "current_candidate_identity_file_sha256": { "const": "b722dd9cc6d49d0292b5ea37df68acebfd3baca2ac28d4e56ac6d3ffc0d807dd" },
        "current_candidate_identity_probe_sha256": { "const": "a7b347561b042ac426595291526d7d29f1f1cd62410bfff3c5131f059703ea91" },
        "artifact_source_matches_current_identity": { "const": true }
      }
    },
    "artifactIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary_vsix", "package_copy_vsix", "exact_match"],
      "properties": {
        "primary_vsix": { "$ref": "#/$defs/primaryVsixIdentity" },
        "package_copy_vsix": { "$ref": "#/$defs/packageCopyVsixIdentity" },
        "exact_match": { "const": true }
      }
    },
    "primaryVsixIdentity": {
      "allOf": [
        { "$ref": "#/$defs/vsixIdentity" },
        {
          "type": "object",
          "properties": {
            "path": { "const": "devseek-netai-2.0.32-debug.20260820.t172525.ga47ffe3.vsix" },
            "sha256": { "const": "8386445523df3b550d9a9edda07e59b594cc3c766e2aecc0a367b9ef5084a854" }
          }
        }
      ]
    },
    "packageCopyVsixIdentity": {
      "allOf": [
        { "$ref": "#/$defs/vsixIdentity" },
        {
          "type": "object",
          "properties": {
            "path": { "const": "packages/vscode-extension/devseek-netai-2.0.32-debug.20260820.t172525.ga47ffe3.vsix" },
            "sha256": { "const": "8386445523df3b550d9a9edda07e59b594cc3c766e2aecc0a367b9ef5084a854" }
          }
        }
      ]
    },
    "vsixIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "package_identity",
        "packaged_bridge_server_sha256"
      ],
      "properties": {
        "path": { "$ref": "#/$defs/nonEmpty" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "package_identity": { "$ref": "#/$defs/packageIdentity" },
        "packaged_bridge_server_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "packageIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["publisher", "name", "version", "devseekBuild"],
      "properties": {
        "publisher": { "const": "devseek-netai" },
        "name": { "const": "devseek-netai" },
        "version": { "const": "2.0.32-debug.20260820.t172525.ga47ffe3" },
        "devseekBuild": {
          "type": "object",
          "additionalProperties": false,
          "required": ["baseVersion", "channel", "buildId", "gitCommit", "packagedAt"],
          "properties": {
            "baseVersion": { "const": "2.0.32" },
            "channel": { "const": "debug" },
            "buildId": { "const": "20260820-t172525" },
            "gitCommit": { "const": "a47ffe3" },
            "packagedAt": { "const": "2026-08-20T09:25:25.020Z" }
          }
        }
      }
    },
    "verificationReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "receipt_id",
        "receipt_kind",
        "verification_scope",
        "evidence",
        "status",
        "source_ref",
        "source_commit",
        "qualification_effect"
      ],
      "properties": {
        "receipt_id": { "$ref": "#/$defs/nonEmpty" },
        "receipt_kind": {
          "enum": [
            "recorded-local-test",
            "recorded-local-user-simulation",
            "recorded-local-install",
            "recorded-local-regression"
          ]
        },
        "verification_scope": { "$ref": "#/$defs/nonEmpty" },
        "evidence": { "$ref": "#/$defs/nonEmpty" },
        "status": { "const": "recorded-passed" },
        "source_ref": { "const": "docs/top-agent-convergence-audit-20260711/HANDOFF-20260813-意图识别与真实用户仿真迭代.md#2026-08-20-2032-t12-模型主导语义与动作回执收敛最新" },
        "source_commit": { "const": "fa682086eb28c0a9ff15093de27dbb3518c4a89f" },
        "qualification_effect": { "const": "NONE" }
      }
    },
    "currentIdentityProbeBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "status",
        "identity_probe_sha256",
        "identity_source_sha256",
        "candidate_source_commit",
        "artifact_source_matches_current_identity",
        "stable_runtime_count",
        "observe_status",
        "qualification_effect",
        "reason"
      ],
      "properties": {
        "path": { "const": "docs/process/devseek-current-candidate-identity.json" },
        "status": { "const": "verified-current-candidate" },
        "identity_probe_sha256": { "const": "a7b347561b042ac426595291526d7d29f1f1cd62410bfff3c5131f059703ea91" },
        "identity_source_sha256": { "const": "b722dd9cc6d49d0292b5ea37df68acebfd3baca2ac28d4e56ac6d3ffc0d807dd" },
        "candidate_source_commit": { "const": "a47ffe37f01817d14358b0ef4040e885b7867c8f" },
        "artifact_source_matches_current_identity": { "const": true },
        "stable_runtime_count": { "const": 1 },
        "observe_status": { "const": "passed" },
        "qualification_effect": { "const": "NONE" },
        "reason": { "$ref": "#/$defs/nonEmpty" }
      }
    },
    "r4LeafContext": {
      "type": "object",
      "additionalProperties": false,
      "required": ["current_leaf", "closure_effect", "remaining_leaves_at_freeze"],
      "properties": {
        "current_leaf": { "const": "R4-RELEASE-CANDIDATE-MANIFEST" },
        "closure_effect": { "$ref": "#/$defs/nonEmpty" },
        "remaining_leaves_at_freeze": {
          "type": "array",
          "maxItems": 0
        }
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "vsix_artifacts",
        "historical_candidates",
        "verification_receipts",
        "remaining_r4_leaves_at_freeze",
        "qualification_claims"
      ],
      "properties": {
        "vsix_artifacts": { "const": 2 },
        "historical_candidates": { "const": 2 },
        "verification_receipts": { "const": 7 },
        "remaining_r4_leaves_at_freeze": { "const": 0 },
        "qualification_claims": { "const": 0 }
      }
    }
  }
}
