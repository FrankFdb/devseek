{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devseek.local/schemas/devseek-run-evidence-seal-v1.json",
  "title": "DevSeek Product Run Evidence Seal v1",
  "$comment": "Product diagnostics only. seal_sha256 is the canonical SHA-256 of this object without seal_sha256.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "integrity_scope",
    "qualification_eligible",
    "run_id",
    "slot_sequence",
    "event_count",
    "final_event_sha256",
    "final_record_sha256",
    "idempotency_key",
    "idempotency_fingerprint_sha256",
    "reason",
    "sealed_at",
    "seal_sha256"
  ],
  "properties": {
    "protocol": { "const": "devseek.run-evidence-seal/v1" },
    "integrity_scope": { "const": "product-run-diagnostics" },
    "qualification_eligible": { "const": false },
    "run_id": { "$ref": "#/$defs/text512" },
    "slot_sequence": { "type": "integer", "minimum": 2, "maximum": 9007199254740991 },
    "event_count": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
    "final_event_sha256": { "$ref": "#/$defs/sha256" },
    "final_record_sha256": { "$ref": "#/$defs/sha256" },
    "idempotency_key": { "$ref": "#/$defs/text512" },
    "idempotency_fingerprint_sha256": { "$ref": "#/$defs/sha256" },
    "reason": { "$ref": "#/$defs/text512" },
    "sealed_at": { "$ref": "#/$defs/canonicalTime" },
    "seal_sha256": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "text512": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "allOf": [
        { "pattern": "^(?!\\s)(?![\\s\\S]*\\s$)(?![\\s\\S]*[\\u0000-\\u001F\\u007F-\\u009F])[\\s\\S]+$" },
        { "pattern": "^(?![\\s\\S]*devseek-ra1_[A-Za-z0-9_-]{43})[\\s\\S]*$" }
      ]
    },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "canonicalTime": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-5][0-9]\\.[0-9]{3}Z$"
    }
  }
}
