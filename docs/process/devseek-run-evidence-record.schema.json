{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devseek.local/schemas/devseek-run-evidence-record-v1.json",
  "title": "DevSeek Product Run Evidence Immutable Record v1",
  "$comment": "The record hash chains the complete event+receipt or seal record to the prior immutable slot.",
  "oneOf": [
    { "$ref": "#/$defs/eventRecord" },
    { "$ref": "#/$defs/sealRecord" }
  ],
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "nullableSha256": {
      "oneOf": [
        { "$ref": "#/$defs/sha256" },
        { "type": "null" }
      ]
    },
    "eventRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol",
        "record_kind",
        "slot_sequence",
        "previous_record_sha256",
        "event",
        "receipt",
        "record_sha256"
      ],
      "properties": {
        "protocol": { "const": "devseek.run-evidence-record/v1" },
        "record_kind": { "const": "event" },
        "slot_sequence": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "previous_record_sha256": { "$ref": "#/$defs/nullableSha256" },
        "event": { "$ref": "https://devseek.local/schemas/devseek-run-evidence-event-v1.json" },
        "receipt": { "$ref": "https://devseek.local/schemas/devseek-run-evidence-receipt-v1.json" },
        "record_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "sealRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol",
        "record_kind",
        "slot_sequence",
        "previous_record_sha256",
        "seal",
        "record_sha256"
      ],
      "properties": {
        "protocol": { "const": "devseek.run-evidence-record/v1" },
        "record_kind": { "const": "seal" },
        "slot_sequence": { "type": "integer", "minimum": 2, "maximum": 9007199254740991 },
        "previous_record_sha256": { "$ref": "#/$defs/sha256" },
        "seal": { "$ref": "https://devseek.local/schemas/devseek-run-evidence-seal-v1.json" },
        "record_sha256": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
