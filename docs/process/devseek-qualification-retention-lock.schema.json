{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devseek.local/schemas/devseek-qualification-retention-lock-v1.json",
  "title": "DevSeek Qualification Manifest Retention Lock v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "integrity", "integrity_scope", "qualification_eligible",
    "lock_id", "manifest_id", "evidence_manifest_sha256", "aggregation_policy_sha256",
    "storage_class", "retained_at", "retain_until", "previous_lock_sha256",
    "lock_sha256", "lock_attestation"
  ],
  "properties": {
    "schema_version": { "const": "devseek.qualification-retention-lock/v1" },
    "integrity": { "$ref": "#/$defs/integrity" },
    "integrity_scope": { "enum": ["local-protocol-conformance", "protected-qualification"] },
    "qualification_eligible": { "type": "boolean" },
    "lock_id": { "$ref": "#/$defs/id" },
    "manifest_id": { "$ref": "#/$defs/id" },
    "evidence_manifest_sha256": { "$ref": "#/$defs/sha256" },
    "aggregation_policy_sha256": { "$ref": "#/$defs/sha256" },
    "storage_class": { "enum": ["append-only-local-cas", "retention-lock-or-worm"] },
    "retained_at": { "$ref": "#/$defs/time" },
    "retain_until": { "$ref": "#/$defs/time" },
    "previous_lock_sha256": { "$ref": "#/$defs/nullableSha256" },
    "lock_sha256": { "$ref": "#/$defs/sha256" },
    "lock_attestation": { "$ref": "#/$defs/attestation" }
  },
  "allOf": [
    {
      "if": {
        "properties": { "integrity_scope": { "const": "local-protocol-conformance" } },
        "required": ["integrity_scope"]
      },
      "then": { "properties": { "qualification_eligible": { "const": false } } }
    },
    {
      "if": {
        "properties": { "storage_class": { "const": "append-only-local-cas" } },
        "required": ["storage_class"]
      },
      "then": { "properties": { "qualification_eligible": { "const": false } } }
    }
  ],
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$" },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "nullableSha256": { "oneOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] },
    "time": { "type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$" },
    "integrity": {
      "type": "object", "additionalProperties": false,
      "required": ["hash_algorithm", "canonicalization_version", "signature_algorithm"],
      "properties": {
        "hash_algorithm": { "const": "sha256" },
        "canonicalization_version": { "const": "devseek-canonical-json/v1" },
        "signature_algorithm": { "const": "ed25519" }
      }
    },
    "attestation": {
      "type": "object", "additionalProperties": false,
      "required": [
        "algorithm", "key_id", "signer_identity", "purpose", "aggregation_policy_sha256",
        "signed_payload_sha256", "signature_base64"
      ],
      "properties": {
        "algorithm": { "const": "ed25519" },
        "key_id": { "$ref": "#/$defs/id" },
        "signer_identity": { "$ref": "#/$defs/id" },
        "purpose": { "const": "retention-lock" },
        "aggregation_policy_sha256": { "$ref": "#/$defs/sha256" },
        "signed_payload_sha256": { "$ref": "#/$defs/sha256" },
        "signature_base64": { "type": "string", "minLength": 1 }
      }
    }
  }
}
