{
  "name": "devseek-netai",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/shared",
    "packages/bridge",
    "packages/cli",
    "packages/vscode-extension"
  ],
  "scripts": {
    "shared:build": "npm run build --workspace=packages/shared",
    "shared:test": "npm run test --workspace=packages/shared",
    "bridge:dev": "npm run dev --workspace=packages/bridge",
    "bridge:build": "npm run build --workspace=packages/bridge",
    "bridge:start": "npm run start --workspace=packages/bridge",
    "cli:build": "npm run build --workspace=packages/cli",
    "cli:typecheck": "npm run typecheck --workspace=packages/cli",
    "cli:test": "npm run test --workspace=packages/cli",
    "extension:package": "npm run extension:package:debug",
    "extension:package:debug": "npm run shared:build && npm run compile --workspace=packages/vscode-extension && DEVSEEK_BUILD_CHANNEL=debug node scripts/package-vsix.mjs",
    "extension:package:release": "npm run shared:build && npm run compile --workspace=packages/vscode-extension && DEVSEEK_BUILD_CHANNEL=release node scripts/package-vsix.mjs",
    "verify": "bash scripts/verify-bridge.sh",
    "verify:phase10": "npm run shared:build && npm run shared:test && npm run bridge:build && npm run test --workspace=packages/bridge && npm run cli:typecheck && npm run cli:build && npm run cli:test && npm run compile --workspace=packages/vscode-extension",
    "verify:phase11": "npm run shared:build && npm run shared:test",
    "verify:phase12": "npm run shared:build && npm run shared:test && npm run cli:typecheck && npm run cli:build && npm run cli:test",
    "verify:phase0-12": "node scripts/devseek-phase0-12-verify.mjs",
    "verify:phase0-12:real": "node scripts/devseek-phase0-12-verify.mjs --real-deepseek",
    "verify:packaged-bridge": "node scripts/verify-packaged-bridge.mjs",
    "verify:artifacts": "node scripts/verify-generated-files.mjs",
    "verify:agent-loop-eval": "npm run shared:build && npm run cli:build && node scripts/devseek-agent-loop-eval.mjs",
    "verify:agent-loop-eval:real": "npm run shared:build && npm run cli:build && node scripts/devseek-agent-loop-eval.mjs --real-deepseek",
    "verify:programming-agent-benchmark": "npm run shared:build && npm run cli:build && node scripts/devseek-programming-agent-benchmark.mjs",
    "verify:architecture-drift": "node scripts/devseek-architecture-drift-check.mjs",
    "generate:active-baseline-selector": "node scripts/devseek-active-baseline-selector-check.mjs --write",
    "verify:active-baseline-selector": "node --test scripts/test/devseek-active-baseline-selector.test.mjs && node scripts/devseek-active-baseline-selector-check.mjs",
    "generate:legacy-doc-inventory": "node scripts/devseek-legacy-doc-inventory-check.mjs --write",
    "verify:legacy-doc-inventory": "node --test scripts/test/devseek-legacy-doc-inventory.test.mjs && node scripts/devseek-legacy-doc-inventory-check.mjs",
    "generate:doc-governance": "node scripts/devseek-doc-governance-check.mjs --write",
    "verify:doc-governance": "node --test scripts/test/devseek-doc-governance.test.mjs && node scripts/devseek-doc-governance-check.mjs",
    "generate:profile-denominator-registry": "node scripts/devseek-profile-denominator-registry-check.mjs --write",
    "verify:profile-denominator-registry": "node --test scripts/test/devseek-profile-denominator-registry.test.mjs && node scripts/devseek-profile-denominator-registry-check.mjs",
    "generate:profile-executor-contracts": "node scripts/devseek-profile-executor-contracts-check.mjs --write",
    "verify:profile-executor-contracts": "node --test scripts/test/devseek-profile-executor-contracts.test.mjs && node scripts/devseek-profile-executor-contracts-check.mjs",
    "generate:current-candidate-identity": "node scripts/devseek-current-candidate-identity-check.mjs --write",
    "verify:current-candidate-identity": "node --test scripts/test/devseek-current-candidate-identity.test.mjs && node scripts/devseek-current-candidate-identity-check.mjs",
    "generate:c0-ledger-wiring": "node scripts/devseek-c0-ledger-wiring-check.mjs --write",
    "verify:c0-ledger-wiring": "node --test scripts/test/devseek-c0-ledger-wiring.test.mjs && node scripts/devseek-c0-ledger-wiring-check.mjs",
    "generate:c0-preregistration-wiring": "node scripts/devseek-c0-preregistration-wiring-check.mjs --write",
    "verify:c0-preregistration-wiring": "node --test scripts/test/devseek-c0-preregistration-wiring.test.mjs && node scripts/devseek-c0-preregistration-wiring-check.mjs",
    "generate:c0-run-evidence-wiring": "node scripts/devseek-c0-run-evidence-wiring-check.mjs --write",
    "verify:c0-run-evidence-wiring": "node --test scripts/test/devseek-c0-run-evidence-wiring.test.mjs && node scripts/devseek-c0-run-evidence-wiring-check.mjs",
    "generate:c0-manifest-aggregator-wiring": "node scripts/devseek-c0-manifest-aggregator-wiring-check.mjs --write",
    "verify:c0-manifest-aggregator-wiring": "node --test scripts/test/devseek-c0-manifest-aggregator-wiring.test.mjs && node scripts/devseek-c0-manifest-aggregator-wiring-check.mjs",
    "generate:external-authority-adapter": "node scripts/devseek-external-authority-adapter-check.mjs --write",
    "verify:external-authority-adapter": "node --test scripts/test/devseek-external-authority-adapter.test.mjs && node scripts/devseek-external-authority-adapter-check.mjs",
    "generate:c0-wiring-reconciliation": "node scripts/devseek-c0-wiring-reconciliation-check.mjs --write",
    "verify:c0-wiring-reconciliation": "node --test scripts/test/devseek-c0-wiring-reconciliation.test.mjs && node scripts/devseek-c0-wiring-reconciliation-check.mjs",
    "generate:capability-ledger": "node scripts/devseek-capability-ledger-check.mjs --write",
    "verify:capability-ledger": "node --test scripts/test/devseek-capability-ledger.test.mjs && node scripts/devseek-capability-ledger-check.mjs",
    "generate:qualification-protocol": "node scripts/devseek-qualification-protocol-check.mjs --write",
    "verify:qualification-protocol": "node --test scripts/test/devseek-qualification-protocol.test.mjs && node scripts/devseek-qualification-protocol-check.mjs",
    "generate:qualification-evidence-manifest": "node scripts/devseek-qualification-evidence-manifest-check.mjs --write",
    "verify:qualification-evidence-manifest": "node --test scripts/test/devseek-qualification-evidence-manifest.test.mjs && node scripts/devseek-qualification-evidence-manifest-check.mjs",
    "verify:qualification-runner": "node --test scripts/test/devseek-qualification-runner.test.mjs && node scripts/devseek-qualification-runner-check.mjs",
    "generate:gate0-decision": "node scripts/devseek-gate0-decision-check.mjs --write",
    "verify:gate0-decision": "node --test scripts/test/devseek-gate0-decision.test.mjs && node scripts/devseek-gate0-decision-check.mjs",
    "generate:run-evidence-contract": "node scripts/devseek-run-evidence-contract-check.mjs --write",
    "verify:run-evidence-contract": "npm run shared:build && node --test scripts/test/devseek-run-evidence-contract.test.mjs scripts/test/devseek-run-evidence-runtime-contract.test.mjs && node scripts/devseek-run-evidence-contract-check.mjs",
    "verify:stability-qualification": "node --test scripts/test/devseek-stability-qualification.test.mjs",
    "verify:real-deepseek-web": "npm run cli:build && node scripts/devseek-real-deepseek-web-eval.mjs",
    "verify:agent-self-loop": "node scripts/devseek-agent-self-loop.mjs",
    "run-log-replay": "node packages/vscode-extension/test/devseek-run-log-replay-harness.mjs",
    "probe:artifacts": "node scripts/probe-generated-files.mjs"
  },
  "devDependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1"
  }
}
