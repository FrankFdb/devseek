{
  "schema_version": "devseek.user-simulation-scenario/v1",
  "iteration_id": "I16",
  "name": "plan-revision",
  "purpose": "Exercise evidence-bound target discovery, multi-file plan revision, strict user scope, workspace containment, and glob-scoped target proposals before any tool effect.",
  "cases": [
    {
      "case_id": "I16-RPL-01",
      "input": {
        "prompt": "Add a feature and its focused test, then verify the project.",
        "workspace_root": "/repo",
        "action_id": "write-feature-and-test",
        "target_paths": [
          "/repo/src/feature.ts",
          "/repo/test/feature.test.ts"
        ]
      }
    },
    {
      "case_id": "I16-SCP-01",
      "input": {
        "prompt": "Only modify src/allowed.ts and verify it.",
        "workspace_root": "/repo",
        "allowed_path": "src/allowed.ts",
        "proposed_path": "src/other.ts",
        "action_id": "write-outside-user-scope"
      }
    },
    {
      "case_id": "I16-BND-01",
      "input": {
        "prompt": "Create the requested implementation in this workspace.",
        "workspace_root": "/repo",
        "proposed_path": "../escaped.ts",
        "action_id": "write-workspace-escape"
      }
    },
    {
      "case_id": "I16-GLO-01",
      "input": {
        "prompt": "Only add implementation files under src and verify them.",
        "workspace_root": "/repo",
        "allowed_scope": "src/**",
        "allowed_path": "src/nested/value.ts",
        "outside_path": "test/value.test.ts",
        "allowed_action_id": "write-under-src",
        "outside_action_id": "write-outside-src"
      }
    }
  ]
}
