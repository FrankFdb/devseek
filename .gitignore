# Dependencies and package manager caches
node_modules/
.npm/
.pnpm-store/
.yarn/

# Build and packaged artifacts
dist/
packages/**/dist/
packages/vscode-extension/media/*
!packages/vscode-extension/media/
!packages/vscode-extension/media/codicon.css
!packages/vscode-extension/media/codicon.ttf
!packages/vscode-extension/media/icon.svg
!packages/vscode-extension/media/marked.umd.js
!packages/vscode-extension/media/mermaid.min.js
!packages/vscode-extension/media/webview-agent-activity.js
!packages/vscode-extension/media/webview-agent-sanitizer.js
!packages/vscode-extension/media/webview-agent-todos.js
!packages/vscode-extension/media/webview-checkpoint.js
!packages/vscode-extension/media/webview-generated-rules.js
!packages/vscode-extension/media/webview-input-suggestions.js
!packages/vscode-extension/media/webview-runtime.json
!packages/vscode-extension/media/webview-sessions.js
!packages/vscode-extension/media/webview-stream-status.js
!packages/vscode-extension/media/webview-working-copy.js
!packages/vscode-extension/media/webview.js
*.vsix
*.tgz
*.log

# Generated reports, probes, and runtime artifacts
artifacts/
backups/
code/
aircraft/
probe_mermaid*.js
packages/vscode-extension/test/unit/*.bundle.cjs
packages/bridge/test/*.bundle.cjs

# Local tool/editor state
.agents/
.codex/
.devseek/
.noop*/
.vscode/

# OS/editor noise
.DS_Store
Thumbs.db
